{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gentle Reminder",
  "version": "1.0.0",
  "identifier": "com.gentlereminder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "title": "Gentle Reminder",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}